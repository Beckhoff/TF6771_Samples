<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.12">
  <POU Name="FB_Proxy" Id="{01052043-50a3-4b33-b1aa-2d3add5472d5}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'no_explicit_call' := 'do not call this POU directly, use Execute Method!'} 
{attribute 'reflection'} 
FUNCTION_BLOCK FB_Proxy
// ┌──────────────┐       ┌────────────────────┐       ┌──────────┐
// │              │       │                    │       │          │
// │   Charging   │       │        Proxy       │       │   OCPP   │
// │ Station (CS) │◄─────►│ Station <-> Client │◄─────►│  Server  │
// │              │       │                    │       │          │
// └──────────────┘       └────────────────────┘       └──────────┘
VAR
	{attribute 'instance-path'} 
    {attribute 'noinit'} 
	_bClientValid 			: BOOL;
	_bStationValid			: BOOL;
	
	_bIsConnected			: BOOL;
	_bIsServerOpen 			: BOOL;
	
	// Client
	_fbClient				: FB_OCPP1_Client(0,0,0);
	bClientConnect 			: BOOL := FALSE; 
	_stClientParam			: ST_OCPP1_ClientParam;
	_eClientAction 			: E_OCPP1_Action;
	// Station
	_fbStation				: FB_OCPP1_Station(sIdent := '', sAuthHash := '', fbServer := 0);
	_eStationAction 		: E_OCPP1_Action;
	
	_stBoot 				: REFERENCE TO ST_OCPP1_ClientBootInfo; 
	_bInitBoot 				: REFERENCE TO BOOL; 
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="ClientRecv" Id="{f2cef4a1-e1e4-48de-82cc-7b15a4e17f6b}" />
    <Folder Name="ServerRecv" Id="{0f58740d-0e69-4f60-b1b7-221b7bcec4bf}" />
    <Method Name="ClientPollRequest" Id="{d07ff275-7412-4470-8d69-f71e9e5cbe8b}" FolderPath="ClientRecv\">
      <Declaration><![CDATA[METHOD ClientPollRequest : BOOL
VAR_INST
	hMessageId 	: T_OCPP_MessageId;
	eError 		: E_OCPP1_Error;
	nState		: UDINT;
END_VAR
VAR CONSTANT

END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _fbClient.PollRequest(hMessageID => hMessageId, eAction => _eClientAction) THEN
	ClientPollRequest := TRUE;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ClientRecvCancelReservation1" Id="{bd101bd1-2a65-4290-85a7-7f8389da8669}" FolderPath="ClientRecv\">
      <Declaration><![CDATA[METHOD ClientRecvCancelReservation1 : BOOL
VAR_INST
	nState			: E_TransmissionState := E_TransmissionState.eClientReceive;
	hMessageId 		: T_OCPP_MessageId;
	eStatus			: E_OCPP1_CancelReservationStatus;
	eError 			: E_OCPP1_Error;
	nReservationId	: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE nState OF
	E_TransmissionState.eClientReceive: 
		IF _fbClient.RecvCancelReservation(hMessageId => hMessageId, nReservationId => nReservationId) THEN
			// Implement data changes here
			nState := E_TransmissionState.eStationSend;
		ELSE 
			_eClientAction := E_OCPP1_Action.None;
		END_IF
	E_TransmissionState.eStationSend:
		IF _fbStation.SendCancelReservation(nReservationId := nReservationId, eStatus => eStatus) THEN
			// Implement data changes here
			nState := E_TransmissionState.eClientRespond;
		END_IF	
	E_TransmissionState.eClientRespond: 
		_fbClient.RespCancelReservation(hMessageId := hMessageId, eStatus := eStatus);
		nState := E_TransmissionState.eFinish;
	E_TransmissionState.eFinish: 
		nState := E_TransmissionState.eClientReceive;		
		_eClientAction := E_OCPP1_Action.None;			
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="ClientRecvChangeAvailability1" Id="{253c6ccb-dd1e-49a9-a44e-e7a5c52d5417}" FolderPath="ClientRecv\">
      <Declaration><![CDATA[METHOD ClientRecvChangeAvailability1 : BOOL
VAR_INST
	nState			: E_TransmissionState := E_TransmissionState.eClientReceive;
	hMessageId 		: T_OCPP_MessageId;
	nConnectorId 	: UDINT;
	eType 			: E_OCPP1_AvailabilityType;
	eStatus 		: E_OCPP1_AvailabilityStatus;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE nState OF
	E_TransmissionState.eClientReceive: 
		IF _fbClient.RecvChangeAvailability(hMessageId => hMessageId, nConnectorId => nConnectorId, eType => eType) THEN
			// Implement data changes here
			nState := E_TransmissionState.eStationSend;
		ELSE 
			_eClientAction := E_OCPP1_Action.None;
		END_IF
	E_TransmissionState.eStationSend:
		IF _fbStation.SendChangeAvailability(nConnectorId := nConnectorId, eType := eType, eStatus => eStatus) THEN
			// Implement data changes here
			nState := E_TransmissionState.eClientRespond;
		END_IF	
	E_TransmissionState.eClientRespond: 
		_fbClient.RespChangeAvailability(hMessageId := hMessageId, eStatus := eStatus);
		nState := E_TransmissionState.eFinish;
	E_TransmissionState.eFinish: 
		nState := E_TransmissionState.eClientReceive;		
		_eClientAction := E_OCPP1_Action.None;			
END_CASE]]></ST>
      </Implementation>
    </Method>
