    <Method Name="ClientRecvDataTransfer1" Id="{2ef82fcd-422b-41b4-885e-11659cda5fdc}" FolderPath="ClientRecv\">
      <Declaration><![CDATA[METHOD ClientRecvDataTransfer1 : BOOL
VAR_INST
	nState		: E_TransmissionState := E_TransmissionState.eClientReceive;
	hMessageId 	: T_OCPP_MessageId;
	sData		: T_OCPP1_DataTransferData;
	sVendorId	: STRING(255);
	sMessageId	: STRING(63);
	eStatus		: E_OCPP1_DataTransferStatus;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE nState OF
	E_TransmissionState.eClientReceive: 
		IF _fbClient.RecvDataTransfer(hMessageId => hMessageId, sVendorId => sVendorId, sMessageId => sMessageId, sData := sData,)  THEN
			// Implement data changes here
			nState := E_TransmissionState.eStationSend;
		ELSE
			_eClientAction := E_OCPP1_Action.None;
		END_IF
		
	E_TransmissionState.eStationSend: 
		IF _fbStation.SendDataTransfer(sVendorId := sVendorId, sData := sData, eStatus => eStatus, sMessageId := sMessageId) THEN
			// Implement data changes here
			nState := E_TransmissionState.eClientRespond;
		END_IF
		
	E_TransmissionState.eClientRespond:
		_fbClient.RespDataTransfer(hMessageId := hMessageId, eStatus := eStatus); 
		nState := E_TransmissionState.eFinish;
		
	E_TransmissionState.eFinish: 
		nState := E_TransmissionState.eClientReceive;		
		_eClientAction := E_OCPP1_Action.None;				
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="ClientRecvGetCompositeSchedule1" Id="{62a425f3-42ab-4176-878b-939edfb3c9e1}" FolderPath="ClientRecv\">
      <Declaration><![CDATA[METHOD ClientRecvGetCompositeSchedule1 : BOOL
VAR_INST
	nState					: E_TransmissionState := E_TransmissionState.eClientReceive;
	hMessageId 				: T_OCPP_MessageId;
	nDuration				: UDINT;
	eChargingRateUnit		: E_OCPP1_ChargingRateUnitType;
	nConnectorId			: UDINT;
	eStatus					: E_OCPP1_GetCompositeScheduleStatus;
	nConnectorIdRes			: UDINT;
	nScheduleStart			: ULINT;
	mChargingSchedule		: ST_OCPP1_ChargingSchedule;
	mChargingScheduleMax	: ST_OCPP1_ChargingScheduleMax;
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE nState OF
	E_TransmissionState.eClientReceive: 
		IF _fbClient.RecvGetCompositeSchedule(hMessageId => hMessageId, nConnectorId => nConnectorId, nDuration => nDuration, eChargingRateUnit => eChargingRateUnit) THEN
			// Implement data changes here
			nState := E_TransmissionState.eStationSend;
		ELSE 
			_eClientAction := E_OCPP1_Action.None;
		END_IF
	E_TransmissionState.eStationSend:
		IF _fbStation.SendGetCompositeSchedule(nConnectorId := nConnectorId, nDuration := nDuration, eChargingRateUnit := eChargingRateUnit, eStatus => eStatus, nConnectorIdRes => nConnectorIdRes, nScheduleStart => nScheduleStart, mChargingSchedule => mChargingScheduleMax) THEN
			mChargingSchedule.eRateUnit 	:= mChargingScheduleMax.eRateUnit;
			mChargingSchedule.fRateMin 		:= mChargingScheduleMax.fRateMin; 
			mChargingSchedule.nDuration 	:= mChargingScheduleMax.nDuration; 
			mChargingSchedule.nPeriodCount 	:= mChargingScheduleMax.nPeriodCount; 
			mChargingSchedule.nStart 		:= mChargingScheduleMax.nStart; 
			
			// Implement data changes here
			nState := E_TransmissionState.eClientRespond;
		END_IF	
	E_TransmissionState.eClientRespond:
		IF eStatus = E_OCPP1_GetCompositeScheduleStatus.Rejected THEN
		 	_fbClient.RespGetCompositeSchedule(hMessageId := hMessageId, eStatus := eStatus, nConnectorId := nConnectorId);
		ELSE
			_fbClient.RespGetCompositeSchedule(hMessageId := hMessageId, eStatus := eStatus, nConnectorId := nConnectorId, nScheduleStart := nScheduleStart, mChargingSchedule := mChargingSchedule);
		END_IF
		nState := E_TransmissionState.eFinish;
	E_TransmissionState.eFinish: 
		nState := E_TransmissionState.eClientReceive;		
		_eClientAction := E_OCPP1_Action.None;			
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="ClientRecvGetConfiguration1" Id="{dd58ee51-d7c8-4425-99c3-fb0772766ae7}" FolderPath="ClientRecv\">
      <Declaration><![CDATA[METHOD ClientRecvGetConfiguration1 : BOOL
VAR_INST
	nState			: E_TransmissionState := E_TransmissionState.eClientReceive;
	hMessageId 		: T_OCPP_MessageId;
	nKeysCount		: UDINT;
	aKeyList		: ARRAY [1..Param_OCPP.nConfigKeysMax] OF T_OCPP1_ConfigKey;
	aKeyValueList	: ARRAY [1..Param_OCPP.nConfigKeysMax] OF ST_OCPP1_ConfigKeyValue;
	nUnknownCount	: UDINT;
	aUnknown		: ARRAY[1..Param_OCPP.nConfigKeysMax] OF T_OCPP1_ConfigKey;
END_VAR
VAR
	i: UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE nState OF
	E_TransmissionState.eClientReceive: 
		IF _fbClient.RecvGetConfiguration(hMessageId => hMessageId, nKeysCount => nKeysCount, aKeys => aKeyList) THEN
			// Implement data changes here
			nState := E_TransmissionState.eStationSend;
		ELSE 
			_eClientAction := E_OCPP1_Action.None;
		END_IF
	E_TransmissionState.eStationSend:
		FOR i := 1 TO Tc3_OCPP.Param_OCPP.nConfigKeysMax BY 1 DO
			aKeyValueList[i].sKey := aKeyList[i];
		END_FOR
		
		IF _fbStation.SendGetConfiguration(aKeys := aKeyValueList, nKeysCount => nKeysCount, nUnknownCount => nUnknownCount) THEN
			// Implement data changes here
			nState := E_TransmissionState.eClientRespond;
		END_IF	
	E_TransmissionState.eClientRespond: 
		_fbClient.RespGetConfiguration(hMessageId := hMessageId, nKeysCount := nKeysCount, nUnknownCount := nUnknownCount, aKeys := aKeyValueList, aUnknown := aUnknown);
		nState := E_TransmissionState.eFinish;
	E_TransmissionState.eFinish: 
		nState := E_TransmissionState.eClientReceive;		
		_eClientAction := E_OCPP1_Action.None;			
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="ClientRecvGetDiagnostics1" Id="{c6ac4056-90c1-41a9-bc87-ab6fd200ef48}" FolderPath="ClientRecv\">
      <Declaration><![CDATA[METHOD ClientRecvGetDiagnostics1 : BOOL
VAR_INST
	nState			: E_TransmissionState := E_TransmissionState.eClientReceive;
	hMessageId 		: T_OCPP_MessageId;
	sLocation		: STRING(255);
	nRetries		: UDINT;
	nRetryInterval	: UDINT;
	nStartTime		: ULINT;
	nStopTime		: ULINT;
	sFileName		: STRING(255);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE nState OF
	E_TransmissionState.eClientReceive: 
		IF _fbClient.RecvGetDiagnostics(hMessageId => hMessageId, sLocation => sLocation, nRetries => nRetries , nRetryInterval => nRetryInterval, nStartTime => nStartTime, nStopTime => nStopTime) THEN
			// Implement data changes here
			nState := E_TransmissionState.eStationSend;
		ELSE 
			_eClientAction := E_OCPP1_Action.None;
		END_IF
	E_TransmissionState.eStationSend:
		IF _fbStation.SendGetDiagnostics(sLocation := sLocation, nRetries := nRetries, nRetryInterval := nRetryInterval, nStartTime := nStartTime, nStopTime := nStopTime , sFileName => sFileName ) THEN
			// Implement data changes here
			nState := E_TransmissionState.eClientRespond;
		END_IF	
	E_TransmissionState.eClientRespond: 
		_fbClient.RespGetDiagnostics(hMessageId := hMessageId, sFileName := sFileName);
		nState := E_TransmissionState.eFinish;
	E_TransmissionState.eFinish: 
		nState := E_TransmissionState.eClientReceive;		
		_eClientAction := E_OCPP1_Action.None;			
END_CASE]]></ST>
      </Implementation>
    </Method>
