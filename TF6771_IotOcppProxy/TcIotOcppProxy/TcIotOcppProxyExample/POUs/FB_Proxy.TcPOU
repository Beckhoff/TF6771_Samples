    <Method Name="ClientRecvClearChargingProfile1" Id="{166b6bb6-69f2-4ff5-ab81-1d46f052a81f}" FolderPath="ClientRecv\">
      <Declaration><![CDATA[METHOD ClientRecvClearChargingProfile1 : BOOL
