		_eClientAction := E_OCPP1_Action.None;			
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="ClientRecvUnlockConnector1" Id="{1cdbe721-2b72-4807-91ef-485d2be05266}" FolderPath="ClientRecv\">
