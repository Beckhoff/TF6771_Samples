    <Method Name="ClientRecvRemoteStopTransaction1" Id="{6d41c5bc-d39a-4d2e-80b3-574324ebf6ba}" FolderPath="ClientRecv\">
      <Declaration><![CDATA[METHOD ClientRecvRemoteStopTransaction1 : BOOL
VAR_INST
	nState			: E_TransmissionState := E_TransmissionState.eClientReceive;
	hMessageId 		: T_OCPP_MessageId;
	nConnectorId 	: UDINT;
	eStatus			: E_OCPP1_RemoteStartStopStatus;
	nTransactionId	: UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE nState OF
	E_TransmissionState.eClientReceive: 
		IF _fbClient.RecvRemoteStopTransaction(hMessageId => hMessageId, nConnectorId => nConnectorId, nTransactionId => nTransactionId)THEN
			// Implement data changes here
			nState := E_TransmissionState.eStationSend;
		ELSE 
			_eClientAction := E_OCPP1_Action.None;
		END_IF
	E_TransmissionState.eStationSend:
		IF _fbStation.SendRemoteStopTransaction(nTransactionId := nTransactionId, eStatus => eStatus) THEN
			// Implement data changes here
			nState := E_TransmissionState.eClientRespond;
		END_IF
	E_TransmissionState.eClientRespond: 
		_fbClient.RespRemoteStopTransaction(hMessageId := hMessageId, eStatus := eStatus); 
		nState := E_TransmissionState.eFinish;
	E_TransmissionState.eFinish: 
		nState := E_TransmissionState.eClientReceive;		
		_eClientAction := E_OCPP1_Action.None;			
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="ClientRecvReserveNow1" Id="{ce560cb4-5a4b-46a5-bd9d-aa1876aaac87}" FolderPath="ClientRecv\">
      <Declaration><![CDATA[METHOD ClientRecvReserveNow1 : BOOL
VAR_INST
	nState			: E_TransmissionState := E_TransmissionState.eClientReceive;
	hMessageId 		: T_OCPP_MessageId;
	nConnectorId	: UDINT;
	nExpiryDate		: ULINT;
	sIdTag			: T_OCPP1_IdToken;
	sParentIdTag	: T_OCPP1_IdToken;
	nReservationId	: UDINT;
	eStatus			: E_OCPP1_ReservationStatus;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE nState OF
	E_TransmissionState.eClientReceive: 
		IF _fbClient.RecvReserveNow(hMessageId => hMessageId, nConnectorId => nConnectorId, nExpiryDate => nExpiryDate, sIdTag => sIdTag, sParentIdTag => sParentIdTag, nReservationId => nReservationId) THEN
			// Implement data changes here
			nState := E_TransmissionState.eStationSend;
		ELSE 
			_eClientAction := E_OCPP1_Action.None;
		END_IF
	E_TransmissionState.eStationSend:
		IF _fbStation.SendReserveNow(nConnectorId := nConnectorId, nExpiryDate := nExpiryDate, sIdTag := sIdTag, sParentIdTag := sParentIdTag, nReservationId := nReservationId, eStatus => eStatus) THEN
			// Implement data changes here
			nState := E_TransmissionState.eClientRespond;
		END_IF
	E_TransmissionState.eClientRespond: 
		_fbClient.RespReserveNow(hMessageId := hMessageId, eStatus := eStatus);
		nState := E_TransmissionState.eFinish;
	E_TransmissionState.eFinish: 
		nState := E_TransmissionState.eClientReceive;		
		_eClientAction := E_OCPP1_Action.None;			
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="ClientRecvReset1" Id="{daabd219-182c-4609-a10d-6995e0c586a7}" FolderPath="ClientRecv\">
      <Declaration><![CDATA[METHOD ClientRecvReset1 : BOOL
VAR_INST
	nState		: E_TransmissionState := E_TransmissionState.eClientReceive;
	hMessageId 	: T_OCPP_MessageId;
	eType		: E_OCPP1_ResetType;
	eStatus		: E_OCPP1_ResetStatus;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE nState OF
	E_TransmissionState.eClientReceive: 
		IF _fbClient.RecvReset(hMessageId => hMessageId, eType => eType) THEN
			// Implement data changes here
			nState := E_TransmissionState.eStationSend;
		ELSE 
			_eClientAction := E_OCPP1_Action.None;
		END_IF
	E_TransmissionState.eStationSend:
		IF _fbStation.SendReset(eType := eType, eStatus => eStatus) THEN
			// Implement data changes here
			nState := E_TransmissionState.eClientRespond;
		END_IF
	E_TransmissionState.eClientRespond: 
		_fbClient.RespReset(hMessageId := hMessageId, eStatus := eStatus);
		nState := E_TransmissionState.eFinish;
	E_TransmissionState.eFinish: 
		nState := E_TransmissionState.eClientReceive;		
		_eClientAction := E_OCPP1_Action.None;		
END_CASE]]></ST>
      </Implementation>
    </Method>
