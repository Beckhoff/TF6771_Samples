END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="ClientRecvUpdateFirmware1" Id="{0fce67f9-a139-4c86-ab05-a1cd1cd9c9fd}" FolderPath="ClientRecv\">
      <Declaration><![CDATA[METHOD ClientRecvUpdateFirmware1 : BOOL
VAR_INST
	nState			: E_TransmissionState := E_TransmissionState.eClientReceive;
	hMessageId 		: T_OCPP_MessageId;
	sLocation		: STRING(255);
	nRetries		: UDINT;
	nRetryInterval	: UDINT;
	nRetrieveDate	: ULINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE nState OF
	E_TransmissionState.eClientReceive: 
		IF _fbClient.RecvUpdateFirmware(hMessageId => hMessageId, sLocation => sLocation, nRetries => nRetries, nRetryInterval => nRetryInterval, nRetrieveDate => nRetrieveDate)  THEN
			// Implement data changes here
			nState := E_TransmissionState.eStationSend;
		ELSE 
			_eClientAction := E_OCPP1_Action.None;
		END_IF
	E_TransmissionState.eStationSend:
		IF _fbStation.SendUpdateFirmware(sLocation := sLocation, nRetries := nRetries, nRetryInterval := nRetryInterval , nRetrieveDate := nRetrieveDate) THEN
			// Implement data changes here
			nState := E_TransmissionState.eClientRespond;
		END_IF	
	E_TransmissionState.eClientRespond: 
		_fbClient.RespUpdateFirmware(hMessageId := hMessageId);
		nState := E_TransmissionState.eFinish;
	E_TransmissionState.eFinish: 
		nState := E_TransmissionState.eClientReceive;		
		_eClientAction := E_OCPP1_Action.None;			
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="Execute" Id="{e7081f7b-d1ff-421e-8228-5b81d5bc5757}">
      <Declaration><![CDATA[METHOD Execute : BOOL
VAR_INST
	bStationError 	: BOOL;
	bClientError 	: BOOL;
	bResetClient 	: BOOL; 
	bResetStation 	: BOOL; 
	bPendingClient 	: BOOL; 
	bPendingStation : BOOL;
END_VAR
VAR_INPUT
END_VAR
// ┌──────────────┐       ┌────────────────────┐       ┌──────────┐
// │              │       │                    │       │          │
// │   Charging   │       │        Proxy       │       │   OCPP   │
// │ Station (CS) │◄─────►│ Station <-> Client │◄─────►│  Server  │
// │              │       │                    │       │  (CSMS)  │
// └──────────────┘       └────────────────────┘       └──────────┘
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//theoretically only when messages are forwarded from the Server to the Client
bStationError := _fbStation.bError; 

//theoretically only when messages are forwarded from the Client to the Server 
bClientError := _fbClient.bError; 

// Manual reset
IF bResetClient THEN 
	_fbClient.Reset(); 
	bResetClient := FALSE; 
END_IF
IF bResetStation THEN 
	_fbStation.Reset();
	bResetStation := FALSE; 
END_IF

bPendingClient := _fbClient.IsPending;
bPendingStation := _fbStation.IsPending;

_bClientValid := _fbClient.bValid;
_bStationValid := _fbStation.bValid;

// Automatic disconnect logic 
_bIsServerOpen := _fbStation.IsConnected;
IF NOT _bIsServerOpen AND _eStationAction <> E_OCPP1_Action.BootNotification THEN 
	bClientConnect := FALSE; 
END_IF
_bIsConnected := _fbClient.IsConnected;
IF NOT _bIsConnected AND _eClientAction <> E_OCPP1_Action.None THEN 
	IF _eClientAction <> E_OCPP1_Action.BootNotification THEN 
		_eClientAction := E_OCPP1_Action.None; 
	END_IF
END_IF

// reconnect on previous Websocket
IF _bIsConnected AND _bInitBoot THEN 
	bClientConnect := TRUE; 
END_IF
_fbClient.Execute(bConnect := bClientConnect);

//////////////////////////////////////////////////
// Message triggered by CS -> StationRecv methods
//////////////////////////////////////////////////

// Communication sample for StartTransaction:
(*
       ChargingStation                                                           Proxy                                                        ChargingStationManagementSystem
 ___________________________       ______________________________________________________________________________________________________       ____________________________
|                           |     |                                |                                  |                                  |     |                            |
| CS.SendStartTransaction   | ──► | Station.RecvStartTransaction   ─►  Client copy StartTransaction   ─►  Client.SendStartTransaction    | ──► | CSMS.RecvStartTransaction  |
|___________________________|     |________________________________|__________________________________|__________________________________|     |____________________________|
                                                                                    Λ
                                                                                    |                                                                        |
                                                           Area for manipulating the data in ServerRecv method                                               | best case:
														   between _fbStation.RecvStartTransaction and _fbClient.SendStartTransaction					     | CSMS accepts StartTransaction
                                                                                                                                                             V								
 ___________________________       ______________________________________________________________________________________________________       ____________________________
|                           |     |                                |                                   |                                 |     |                            |
| CS.Send{Output => accept} | ◄── |      Station.Resp{accept}      ◄─ Client passes message to Station ◄─  Client.Send{Output => accept} | ◄── |     CSMS.Resp{accepted}    |
|___________________________|     |________________________________|___________________________________|_________________________________|     |____________________________|

*)
CASE _eStationAction OF
	E_OCPP1_Action.None: 							StationPollRequest1();
	E_OCPP1_Action.Authorize: 						StationRecvAuthorize1();			
	E_OCPP1_Action.BootNotification:				StationRecvBootNotification1();
	E_OCPP1_Action.DataTransfer: 					StationRecvDataTransfer1();
	E_OCPP1_Action.DiagnosticsStatusNotification: 	StationRecvDiagnosticsStatusNotification1();
	E_OCPP1_Action.FirmwareStatusNotification: 		StationRecvFirmwareStatusNotification1();
	E_OCPP1_Action.Heartbeat: 						StationRecvHeartbeat1();
	E_OCPP1_Action.MeterValues: 					StationRecvMeterValues1();
	E_OCPP1_Action.SecurityEventNotification: 		StationRecvSecurityEventNotification1();
	E_OCPP1_Action.StartTransaction: 				StationRecvStartTransaction1();
	E_OCPP1_Action.StatusNotification: 				StationRecvStatusNotification1();
	E_OCPP1_Action.StopTransaction: 				StationRecvStopTransaction1();
END_CASE

//////////////////////////////////////////////////
// Message triggered by CSMS -> ClientRecv Methods
//////////////////////////////////////////////////

// Communication Sample for RemoteStartTransaction:
(* 
   ChargingStationManagementSystem                                                               Proxy                                                                     ChargingStation
 ___________________________________       ________________________________________________________________________________________________________________       __________________________________ 
|                                   |     |                                      |                                 |                                       |     |                                  |
| CSMS.Send{RemoteStartTransaction} | ──► |  Client.Recv{RemoteStartTransaction} ─► Station copy TransactionInfo   ─►  Server.Send{RemoteStartTransaction} | ──► | CS.Recv{RemoteStartTransaction}  |
|___________________________________|     |______________________________________|_________________________________|_______________________________________|     |__________________________________|
                                                                                                   Λ
                                                                                                   |                                                                                 |
                                                                          Area for manipulating the data in ClientRecv Method                                                        | best case:
																between _fbStation.SendRemoteStartTransaction and _fbClient.RecvRemoteStartTransaction  						     | CS accepts RemoteStartTransaction
														                    	     		     												                                     V

 ___________________________________       ________________________________________________________________________________________________________________       __________________________________ 
|                                   |     |                                       |                                 |                                      |     |                                  |
|    CSMS.Send{Output => accept}    | ◄── | Client.Resp{RemoteStartTransaction}   ◄─  Station passes msg to Client  ◄─    Server.Send{Output => accept}    | ◄── |          CS.Resp{accept}         |
|___________________________________|     |_______________________________________|_________________________________|______________________________________|     |__________________________________|
*)
CASE _eClientAction OF
	E_OCPP1_Action.None: 						ClientPollRequest();
	E_OCPP1_Action.CancelReservation: 			ClientRecvCancelReservation1();
	E_OCPP1_Action.ChangeAvailability: 			ClientRecvChangeAvailability1();
	E_OCPP1_Action.ChangeConfiguration: 		ClientRecvChangeConfiguration1();
	E_OCPP1_Action.SetChargingProfile: 			ClientRecvSetChargingProfile1();
	E_OCPP1_Action.ClearCache: 					ClientRecvClearCache1();
	E_OCPP1_Action.ClearChargingProfile: 		ClientRecvClearChargingProfile1();
	E_OCPP1_Action.GetCompositeSchedule: 		ClientRecvGetCompositeSchedule1();
	E_OCPP1_Action.GetConfiguration: 			ClientRecvGetConfiguration1();
	E_OCPP1_Action.GetDiagnostics: 				ClientRecvGetDiagnostics1();
	E_OCPP1_Action.GetLocalListVersion: 		ClientRecvGetLocalListVersion1();
	E_OCPP1_Action.SendLocalList: 				ClientRecvLocalList1();
	E_OCPP1_Action.RemoteStartTransaction: 		ClientRecvRemoteStartTransaction1();
	E_OCPP1_Action.RemoteStopTransaction: 		ClientRecvRemoteStopTransaction1();
	E_OCPP1_Action.ReserveNow: 					ClientRecvReserveNow1();
	E_OCPP1_Action.Reset: 						ClientRecvReset1();
	E_OCPP1_Action.TriggerMessage: 				ClientRecvTriggerMessage1();
	E_OCPP1_Action.UnlockConnector: 			ClientRecvUnlockConnector1();
	E_OCPP1_Action.UpdateFirmware: 				ClientRecvUpdateFirmware1();
	E_OCPP1_Action.DataTransfer: 				ClientRecvDataTransfer1();
END_CASE



 
]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{21987080-eb09-4fec-aa1f-e1f69cfdf0e3}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains		: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode			: BOOL; // TRUE: the instance will be copied to the copy code afterward (online change)   
	fbServer			: REFERENCE TO FB_OCPP1_Server;
	stClientParam		: ST_OCPP1_ClientParam;
	stBootInfo 			: REFERENCE TO ST_OCPP1_ClientBootInfo;
	sIdent				: T_OCPP_Identity;
	sAuthHash			: T_OCPP_Hash;
	tConnectionTimeout	: TIME;
	bInitBoot 			: REFERENCE TO BOOL;
END_VAR


]]></Declaration>
      <Implementation>
        <ST><![CDATA[FB_Init:= this^.Init(fbServer := fbServer, stClientParam := stClientParam, stBootInfo := stBootInfo, sIdent := sIdent, sAuthHash := sAuthHash, tConnectionTimeout := tConnectionTimeout, bInitBoot := bInitBoot);]]></ST>
      </Implementation>
    </Method>
    <Method Name="Init" Id="{74d88e78-d958-4ef2-9479-9f941b576286}">
      <Declaration><![CDATA[METHOD Init : BOOL
VAR_INPUT
	fbServer			: REFERENCE TO FB_OCPP1_Server;
	stClientParam		: ST_OCPP1_ClientParam;
	stBootInfo 			: REFERENCE TO ST_OCPP1_ClientBootInfo;
	sIdent				: T_OCPP_Identity;
	sAuthHash			: T_OCPP_Hash;
	tConnectionTimeout	: TIME;
	bInitBoot 			: REFERENCE TO BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Init := _fbStation.Init(sIdent, sAuthHash, fbServer) AND _fbClient.Init(stParam := stClientParam) AND _fbClient.InitBootInfo(stBootInfo);
_stBoot REF= stBootInfo; 
_bInitBoot REF= bInitBoot; 
_stClientParam := stClientParam;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="StationPollRequest1" Id="{9ccda700-2443-43b1-93c8-2bc606eb88ac}" FolderPath="ServerRecv\">
      <Declaration><![CDATA[METHOD StationPollRequest1 : BOOL
VAR_INST
	hStationId 	: UDINT;
	hMessageId	: T_OCPP_MessageId;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _fbStation.PollRequest(hMessageID => hMessageId, eAction => _eStationAction) THEN
	StationPollRequest1 := TRUE;
END_IF
 ]]></ST>
      </Implementation>
    </Method>
    <Method Name="StationRecvAuthorize1" Id="{ee109a3b-b384-434f-9e22-04a3edec7a92}" FolderPath="ServerRecv\">
      <Declaration><![CDATA[METHOD StationRecvAuthorize1 : BOOL
VAR_INST
	nState		: E_TransmissionState := E_TransmissionState.eStationReceive;
	hMessageId 	: T_OCPP_MessageId;
	sIdTag 		: T_OCPP1_IdToken;
	eStatus 	: E_OCPP1_AuthorizationStatus;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE nState OF
	E_TransmissionState.eStationReceive: 
		IF _fbStation.RecvAuthorize(hMessageId => hMessageId, sIdTag => sIdTag)  THEN
			// Implement data changes here
			nState := E_TransmissionState.eClientSend;
		ELSE 
			_eStationAction := E_OCPP1_Action.None;
		END_IF
	E_TransmissionState.eClientSend:
		IF _fbClient.SendAuthorize(sIdTag := sIdTag, eStatus => eStatus) THEN
			// Implement data changes here
			nState := E_TransmissionState.eStationRespond;
		END_IF	
	E_TransmissionState.eStationRespond: 
		_fbStation.RespAuthorize(hMessageId := hMessageId , eStatus := eStatus);
		nState := E_TransmissionState.eFinish;
	E_TransmissionState.eFinish: 
		nState := E_TransmissionState.eStationReceive;		
		_eStationAction := E_OCPP1_Action.None;			
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="StationRecvBootNotification1" Id="{a90d1d2a-4edc-4a2c-abae-3206910ff15c}" FolderPath="ServerRecv\">
      <Declaration><![CDATA[METHOD StationRecvBootNotification1 : BOOL
VAR_INST
	nState				: E_TransmissionState := E_TransmissionState.eStationReceive;
	hMessageId 			: T_OCPP_MessageId;
	sModel				: STRING(31);
	sVendor				: STRING(31);
	sChargeBoxSerial	: STRING(31);
	sChargePointSerial	: STRING(31);
	sFirmwareVersion	: STRING(63);
	sMeterSerial		: STRING(31);
	sMeterType			: STRING(31);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE nState OF
	E_TransmissionState.eStationReceive: 
		IF _fbStation.RecvBootNotification(hMessageId => hMessageId, sModel => sModel, sVendor => sVendor, sChargeBoxSerial => sChargeBoxSerial, sChargePointSerial => sChargePointSerial, sFirmwareVersion => sFirmwareVersion, sMeterSerial => sMeterSerial, sMeterType => sMeterType)  THEN
			_stBoot.sChargePointModel 			:= sModel;
			_stBoot.sChargePointVendor 			:= sVendor;
			_stBoot.sChargeBoxSerialNumber 		:= sChargeBoxSerial;
			_stBoot.sChargePointSerialNumber 	:= sChargePointSerial;
			_stBoot.sFirmwareVersion 			:= sFirmwareVersion;
			_stBoot.sMeterSerialNumber 			:= sMeterSerial;
			_stBoot.sMeterType 					:= sMeterType;
			// Implement data changes here
			nState 								:= E_TransmissionState.eClientSend;
		ELSE 
			_eStationAction := E_OCPP1_Action.None;
		END_IF
	E_TransmissionState.eClientSend:
		// Update BootInfo
		IF _fbClient.InitBootInfo(stBootInfo := _stBoot) THEN
			_bInitBoot := TRUE;
			// Send BootNotification with setting bClientConnect to TRUE
			bClientConnect := TRUE;
			// Implement data changes here
			nState := E_TransmissionState.eStationRespond;
		END_IF	
	E_TransmissionState.eStationRespond: 
		IF _fbClient.IsConnected THEN
			_fbStation.RespBootNotification(hMessageId := hMessageId, eStatus:= E_OCPP1_RegistrationStatus.Accepted, tHeartbeatInterval := _fbClient.HeartbeatInterval);
			nState := E_TransmissionState.eFinish;
		ELSIF _fbClient.hrErrorResult = 16#719 THEN 
			bClientConnect := FALSE; 
			_eStationAction := E_OCPP1_Action.None;	
		END_IF

	E_TransmissionState.eFinish: 
		nState := E_TransmissionState.eStationReceive;		
		_eStationAction := E_OCPP1_Action.None;			
END_CASE
]]></ST>
      </Implementation>
    </Method>
