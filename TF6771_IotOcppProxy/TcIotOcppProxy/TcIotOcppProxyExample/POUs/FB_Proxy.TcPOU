    <Method Name="ClientRecvLocalList1" Id="{e6349d5b-ee2a-4e36-8f83-b0f92b74a2ea}" FolderPath="ClientRecv\">
      <Declaration><![CDATA[METHOD ClientRecvLocalList1 : BOOL
VAR_INST
	nState			: E_TransmissionState := E_TransmissionState.eClientReceive;
